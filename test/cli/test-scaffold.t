`jacquard test --scaffold FILE` prints an exploration-test skeleton for FILE's `multi` effects
(TEST.5): a forwarding handler that answers each operation with `explore.branch` over the
outcomes its result type lists, an `explore.all` helper, and a Case per entry point whose
property is a TODO. It is formatted, and checked together with FILE before it is printed.

  $ export JACQUARD_PRELUDE=../../prelude
  $ sed -n '/^type Outcome/,/^count(rs, v)/p' ../../bench/startup/transfer.jac > machine.jac
  $ jacquard test --scaffold machine.jac > machine-explore-test.jac; echo "exit:$?"
  exit:0
  $ cat machine-explore-test.jac
  -- Exploration tests for machine.jac, generated by `jacquard test --scaffold`.
  -- Save next to it and run: jacquard test machine.jac <this file>
  bank-world(
    body,
  ) =
    handle body() {
      | return v -> v
      | debit(_, _) resume k -> k(explore.branch("debit", [Ok, Rejected, Timeout]))
      | credit(_, _) resume k -> k(explore.branch("credit", [Ok, Rejected, Timeout]))
      | journal(_) resume k -> k(())
    }
  
  bank-runs(thunk) = explore.all(fn () -> bank-world(thunk))
  
  credit-up-to-explored : Test
  credit-up-to-explored =
    Case(
      "credit-up-to on every outcome (TODO: state the property)",
      fn () ->
        {
          let runs = bank-runs(fn () -> credit-up-to("", 0, 0))
          check.true(list.all?(runs, fn (run) -> True), "TODO: replace True with the property")
        },
    )
  
  transfer-explored : Test
  transfer-explored =
    Case(
      "transfer on every outcome (TODO: state the property)",
      fn () ->
        {
          let runs = bank-runs(fn () -> transfer("", "", 0))
          check.true(list.all?(runs, fn (run) -> True), "TODO: replace True with the property")
        },
    )
  $ jacquard test machine.jac machine-explore-test.jac; echo "exit:$?"
  PASS credit-up-to-explored/credit-up-to on every outcome (TODO: state the property) (1 check, 1 execution explored, complete)
  PASS transfer-explored/transfer on every outcome (TODO: state the property) (1 check, 129 executions explored, complete)
  2 passed, 0 failed, 0 skipped, 0 refused
  cache: 0 hit, 2 ran
  exit:0

An operation whose result type has no listable outcomes gets a TODO outcome list, which prunes until
it is filled in; list parameters get `[]`, and each property is a TODO.

  $ cat > open.jac <<'EOF'
  > multi effect Store where {
  >   lookup : (Text) -> Int
  >   seen : (Text) -> Bool
  > }
  > fetch(key) = if seen(key) then lookup(key) else 0
  > fetch-all(keys) = list.map(keys, fetch)
  > EOF
  $ jacquard test --scaffold open.jac > open-explore-test.jac; echo "exit:$?"
  exit:0
  $ grep -c "TODO" open-explore-test.jac
  5
  $ jacquard test open.jac open-explore-test.jac > open.out; echo "exit:$?"
  exit:0

A `once` effect and an entry point with an effect the scaffold does not handle are named in
comments, and a polymorphic entry point gets a Case like any other.

  $ cat > edge.jac <<'EOF'
  > multi effect Coin where {
  >   flip : () -> Bool
  > }
  > once effect Log where {
  >   note : (Text) -> ()
  > }
  > pick(xs) = if flip() then xs else []
  > both(n) = { note("x"); if flip() then n else 0 }
  > twice(n) = if flip() then n else int.add(n, 1)
  > EOF
  $ jacquard test --scaffold edge.jac > edge-explore-test.jac; echo "exit:$?"
  exit:0
  $ grep -E "^--|-explored =" edge-explore-test.jac
  -- Exploration tests for edge.jac, generated by `jacquard test --scaffold`.
  -- Save next to it and run: jacquard test edge.jac <this file>
  -- Log is not explored: exploration needs a `multi` effect without parameters.
  pick-explored =
  -- TODO: both performs several effects ((Int) ->{Log, Coin} Int); a scaffold Case explores one. Write its case.
  twice-explored =
  $ jacquard test edge.jac edge-explore-test.jac; echo "exit:$?"
  PASS pick-explored/pick on every outcome (TODO: state the property) (1 check, 2 executions explored, complete)
  PASS twice-explored/twice on every outcome (TODO: state the property) (1 check, 2 executions explored, complete)
