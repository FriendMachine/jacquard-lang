(executable
 (name docs_doctest)
 (modules docs_doctest)
 (libraries unix))

(rule
 (alias runtest)
 (deps
  docs_doctest.exe
  %{bin:jacquard}
  (source_tree fixtures)
  (source_tree ../../prelude)
  (source_tree ../../runtime)
  ../../README.md
  ../../docs/effect-membranes.md
  ../../docs/effect-taxonomy.md
  ../../docs/concurrency.md
  ../../docs/tutorial.md
  ../../docs/SKILL.md
  ../../docs/skill/commands.md
  ../../docs/skill/code-and-grammar.md
  ../../docs/skill/capabilities-and-host.md
  ../../docs/skill/dist.md
  ../../docs/skill/warp.md
  ../../docs/skill/review-and-identity.md
  ../../docs/skill/native-and-carriers.md
  ../../docs/stdlib.md
  ../../docs/warp-testing.md
  ../../demos/README.md)
 (action
  (setenv TMPDIR .
   (progn
    (run ./docs_doctest.exe --self-test %{bin:jacquard} ../../prelude)
    (run ./docs_doctest.exe %{bin:jacquard} ../../prelude fixtures
     ../../README.md
     ../../docs/effect-membranes.md
     ../../docs/effect-taxonomy.md
     ../../docs/concurrency.md
     ../../docs/tutorial.md
     ../../docs/SKILL.md
     ../../docs/skill/commands.md
     ../../docs/skill/code-and-grammar.md
     ../../docs/skill/capabilities-and-host.md
     ../../docs/skill/dist.md
        ../../docs/skill/warp.md
     ../../docs/skill/review-and-identity.md
     ../../docs/skill/native-and-carriers.md
     ../../docs/stdlib.md
     ../../docs/warp-testing.md
     ../../demos/README.md)))))
